k112four.out <- kmeans(dwnom112, centers = 4, nstart = 5) # The kmeans function performs k-means clustering on the dwnom112 data, specifying 4 centers (clusters) and using nstart = 5 to run the algorithm multiple times with different initial cluster centers to find the best solution.
