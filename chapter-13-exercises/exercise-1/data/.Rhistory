artist_genre_popularity <- track_tbl %>%
filter(is.na(Composer) == FALSE) %>% # Filter out tracks without a composer. "is.na" stands for "is not available"
group_by(GenreId, Composer) %>% # Group by GenreId and Composer
count() %>% # Count the number of tracks for each genre and composer
arrange(GenreId, -n) %>% # Arrange by GenreId and descending count
group_by(GenreId) %>% # Group by GenreId again to get the most popular artist for each genre
slice_max(n, n = 1) %>% # Get the most popular artist for each genre
left_join(genre_df, by = "GenreId") %>% # Join with the genre table to get genre names
select(GenreId, Genre.Name, Composer, n) %>% # Select relevant columns
collect() # Collect the data into memory to view it
