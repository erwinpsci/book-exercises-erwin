count() %>% # Count the number of tracks for each genre and composer
left_join(genre_df) %>% # Join with the genre table to get genre names
select(Genre = Name, Composer, count = n) %>% # Select relevant columns
collect() %>%  # Collect the data into memory to view it
group_by(Genre) %>% # Group by Genre
filter(count == max(count)) %>% # Filter for the maximum count in each genre
arrange(-count) %>% # Arrange in descending order by count
