avocado <- read.csv("avocado.csv", stringsAsFactors = FALSE)
setwd("/Users/haoxi-home/Library/CloudStorage/OneDrive-UniversityofWaterloo/book-exercises-erwin/chapter-12-exercises/exercise-1/data")
# Load the `data/avocado.csv` file into a variable `avocados`
# Make sure strings are *not* read in as factors
avocado <- read.csv("avocado.csv", stringsAsFactors = FALSE)
View(avocado)
View(avocado)
# To tell R to treat the `Date` column as a date (not just a string)
# Redefine that column as a date using the `as.Date()` function
# (hint: use the `mutate` function)
avocado <- avocado %>%
mutate(Date= as.Date(Date))
head(avocado)
str(avocado$Date)
# The file had some uninformative column names, so rename these columns:
# `X4046` to `small_haas`
# `X4225` to `large_haas`
# `X4770` to `xlarge_haas`
avocado <- avocado %>%
rename(small_haas = X4046,
large_haas = X4225,
large_haas = X4770)
# The file had some uninformative column names, so rename these columns:
# `X4046` to `small_haas`
# `X4225` to `large_haas`
# `X4770` to `xlarge_haas`
avocado <- avocado %>%
rename(small_haas = X4046,
large_haas = X4225,
xlarge_haas = X4770)
# The data only has sales for haas avocados. Create a new column `other_avos`
# that is the Total.Volume minus all haas avocados (small, large, xlarge)
avocado <- avocado %>%
mutate(other_avos = Total.Volume - (small_haas + large_haas + xlarge_haas))
by_size <- avocado %>%
select(Date, other_avos, small_haas, large_haas, xlarge_haas)
View(by_size)
size_gathered <- by_size %>%
gather(key = "size",
value = "volume",
other_avos, small_haas, large_haas, xlarge_haas)
View(size_gathered)
# Using `size_gathered`, compute the average sales volume of each size
# (hint, first `group_by` size, then compute using `summarize`)
average_sales <- size_gathered %>%
group_by(size) %>%
summarize(average_volume = mean(volume, na.rm = TRUE))
ggplot(size_gathered) %>%
geom_smooth(mapping = aes(x = Date, y=volume, col = size),
se = FALSE) # This will create a smooth line for each avocado size over time
ggplot(size_gathered) %>%
geom_smooth(mapping = aes(x = Date, y=volume, col = size),
se = FALSE) # This will create a smooth line for each avocado size over time
ggplot(data = size_gathered) +
geom_smooth(mapping = aes(x = Date, y=volume, col = size),
se = FALSE) # This will create a smooth line for each avocado size over time
by_type <- avocado %>%
group_by(Date, type) %>%
summarize(volume = sum(Total.Volume))
View(by_type)
by_type_wide <- by_type %>%
spread(key = type,
value = volume,
fill = 0) # fill = 0 means that if there is no data for a type, it will be filled with 0
View(by_type_wide)
ggplot(data = by_type_wide) +
geom_point(mapping = aes(x = conventional, y = organic), col = type) +
labs(x = "Conventional",
y = "Organic",
title = "Avocado Sales: Conventional vs Organic")
