base_uri <- "https://api.nytimes.com/svc/search/v2"
resource <- "/articlesearch.json"
query_params <- list(
"api-key" = nyt_apikey,
q = "political science",
sort = "newest"
)
response <- GET(paste0(base_uri, resource), query = query_params)
body <- fromJSON(content(response, "text"))
print(str(body))  # Display the structure of the entire response
articles <- body$response$docs
str(articles)
# Optional: extract useful fields from the first result
if (!is.null(articles) && nrow(articles) > 0) {
headline <- articles$headline$main[1]
summary <- articles$abstract[1]
url <- articles$web_url[1]
article_info <- list(headline = headline, summary = summary, url = url)
print(article_info)
}
reviews <- body$response$docs  # Extract the 'docs' element from the response
if (!is.null(reviews) && nrow(reviews) > 0) {
latest_review <- reviews[1, ]  # Get the most recent review
headline <- latest_review$headline$main
summary <- latest_review$abstract
url <- latest_review$web_url
} else {
headline <- NA
summary <- NA
url <- NA
}
if (!is.null(reviews) && nrow(reviews) > 0) {
latest_review <- reviews[1, ]  # Get the most recent review
headline <- latest_review$headline$main
